table fact_sales
	lineageTag: 0623e6a9-061b-453d-b5b7-9f30adeffa3b

	measure 'Sales Total' = sum(fact_sales[Sales Amount])
		lineageTag: 23e0b554-7d91-4ffa-b693-d6a4a08bb3bd

		formatStringDefinition = FormatAmounts()

	measure 'Profit Total' = SUM(fact_sales[Profit Amount])
		lineageTag: f2e501ac-a067-4f34-bb5f-c2bfe6f1021c

		formatStringDefinition = FormatAmounts()

	measure 'Profit Margin Percent' = DIVIDE([Profit Total],fact_sales[Sales Total])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ca139fdf-387d-46ff-ad42-f0967c84b784

	measure 'Profit Margin Target Met?' =
			
			VAR MetTarget =
			    [Profit Margin Percent] >= 0.20
			
			VAR IconColor =
			    IF( MetTarget, "#2E7D32", "#C62828" )
			
			VAR IconPath =
			    IF(
			        MetTarget,
			        "M9 16.2 L4.8 12 L3.4 13.4 L9 19 L21 7 L19.6 5.6 Z",
			        "M6 6 L18 18 M18 6 L6 18"
			    )
			
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='18' height='18'>" &
			    "<path d='" & IconPath & "' " &
			    "fill='" & IF(MetTarget, IconColor, "none") & "' " &
			    "stroke='" & IconColor & "' " &
			    "stroke-width='2' stroke-linecap='round'/>" &
			"</svg>"
		lineageTag: 9ab0cfab-ca8c-4795-97e0-1bdaa556abe5
		dataCategory: ImageUrl

	measure 'Avg Product Sales' = fact_sales[Sales Total]/DISTINCTCOUNTNOBLANK(dim_product[Product ID])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2a9e56c3-19b4-465f-8531-d0e70453b7d0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Sales Amount'
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 890922b5-3514-489c-af10-b7f238986c83
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Sales Amount]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Profit Amount'
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 27a47e4e-cc89-4300-a7a1-935dd32b6271
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Profit Amount]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Product ID'
		lineageTag: d7060c75-9032-4999-a9cd-5646d4e22a1e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product ID]

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Country ID'
		formatString: 0
		lineageTag: 84e5ecd1-ea54-4108-8608-6568b2e933bc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Country ID]

		annotation SummarizationSetBy = User

	partition fact_sales = calculated
		mode: import
		source =
				
				DATATABLE(
				"Product ID", INT64,
				"Country ID", INT64,
				"Sales Amount", DECIMAL,
				"Profit Amount", DECIMAL,
				    {
				        { 1, 1, 15250.25, 4252.55},
				        { 1, 2, 12150.27, 2170.35},
				        { 1, 3, 11350.45, 1380.82},
				        { 1, 4, 1023420.25, 113780.71},
				        { 1, 5, 6250.26, 748.23},
				        { 2, 1, 175300.77, 45350.75},
				        { 2, 2, 13500.79, 1500.78},
				        { 2, 3, 358500.25, 88800.85},
				        { 2, 4, 44500.45, 4380.95},
				        { 2, 5, 14500.75, 4792.75},
				        { 3, 1, 7400.10, 707.10},
				        { 3, 2, 76004.1, 1394.10},
				        { 3, 3, 920.13, 229.10},
				        { 3, 4, 4000.11, 1001.12},
				        { 3, 5, 3200.14, 102.18},
				        { 4, 1, 2925.90, 932.82},
				        { 4, 2, 24125.92, 2825.94},
				        { 4, 3, 22124.85, 2129.86},
				        { 4, 4, 10135.72, 1375.79},
				        { 4, 5, 675.62, 205.17}
				    }
				)

	annotation PBI_Id = 0283bc5467ad45c2a922f74cc5dd7f86

